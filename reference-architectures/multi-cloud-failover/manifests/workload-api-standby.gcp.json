{
  "name": "payments-api-primary",
  "namespace": "default",
  "image": "your-registry/payments-api:v1.4.0",
  "replicas": 1,
  "backend": "kubernetes",
  "resources": {
    "cpuRequest": "250m",
    "cpuLimit": "1",
