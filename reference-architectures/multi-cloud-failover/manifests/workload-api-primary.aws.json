{
  "name": "payments-api-primary",
  "namespace": "default",
  "image": "your-registry/payments-api:v1.4.0",
  "replicas": 3,
  "backend": "kubernetes",
  "resources": {
    "cpuRequest": "500m",
    "cpuLimit": "2",
    "memoryRequest": "512Mi",
    "memoryLimit": "2Gi"
  },
  "labels": {
    "kranix.io/cloud": "aws",
    "kranix.io/role": "primary",
    "kranix.io/app": "payments-api"
  }
}
